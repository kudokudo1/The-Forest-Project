assert r1_task["temporary_capabilities"] == [
    "cap-R1"
]
assert r1_task["task_sticky_skills"] == [
    "skill-R1"
]

assert r2_task["temporary_capabilities"] == []
assert r2_task["task_sticky_skills"] == []

print("PASS 12: R1 temporary capabilities do not leak")
print("PASS 13: R1 task-sticky Skills do not leak")


