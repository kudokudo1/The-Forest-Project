
# === FOREST NUMPAD MODES — NUM LOCK OFF ===
# Numpad 1: Forest Normal Mode
bindsym --release KP_End exec --no-startup-id kitty --hold /usr/local/bin/forest-normal-mode

# Numpad 2: Pine Cone Mode
bindsym --release KP_Down exec --no-startup-id kitty --hold /usr/local/bin/pine-cone-mode

# Numpad 3: Maple Seed Mode
bindsym --release KP_Next exec --no-startup-id kitty --hold /usr/local/bin/maple-seed-mode
